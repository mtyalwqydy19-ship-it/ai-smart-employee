# انسخ هذا الملف إلى .env واملأ القيم الحقيقية في بيئتك الخاصة فقط.
# لا تضع .env داخل Git أبدًا.

# مثال الصيغة (استبدل القيم بمعلومات قاعدة بياناتك الحقيقية):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=

# سرّ توقيع جلسات الدخول. في production: 32 حرفًا على الأقل، عشوائي تمامًا.
# يمكن توليد واحد محليًا بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=openai,claude

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

PORT=3000

# تطوير فقط — يرفض العمل تلقائيًا إن كان NODE_ENV=production (راجع src/seed/demoClinic.ts)
SEED_DEMO=false
# اختياري: إن وُضعت يُنشأ مستخدم تجريبي demo-owner@demo.invalid بهذه الكلمة. لا تضع كلمة مرور حقيقية هنا.
DEMO_SEED_PASSWORD=
